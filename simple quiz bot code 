def type_text(text, delay=0.01):
    """Print text with a small typing effect."""
    for character in text:
        print(character, end="", flush=True)
        time.sleep(delay)
    print()


def ask_question(number, question):
    """Display a question and return whether the answer is correct."""
    print(f"\nQuestion {number}/10")
    print("-" * 40)
    print(question["question"])

    for option in question["options"]:
        print(option)

    while True:
        answer = input("\nYour answer (A/B/C/D): ").strip().upper()

        if answer in {"A", "B", "C", "D"}:
            break

        print("⚠️ Please enter A, B, C, or D.")

    if answer == question["answer"]:
        print("✅ Correct!")
        return True

    print(f"❌ Not quite. The correct answer was {question['answer']}.")
    return False


def run_quiz():
    """Run one quiz session."""
    selected_questions = random.sample(QUESTIONS, min(10, len(QUESTIONS)))
    score = 0

    type_text("\n🤖 QuizBot: Let's begin!")

    for number, question in enumerate(selected_questions, start=1):
        if ask_question(number, question):
            score += 1

    percentage = (score / len(selected_questions)) * 100

    print("\n" + "=" * 40)
    print("🏁 QUIZ COMPLETE")
    print("=" * 40)
    print(f"Score:      {score}/{len(selected_questions)}")
    print(f"Percentage: {percentage:.0f}%")

    if percentage == 100:
        print("🏆 Perfect score! You're a Python master!")
    elif percentage >= 80:
        print("🔥 Excellent work!")
    elif percentage >= 60:
        print("👍 Good job! Keep practicing.")
    else:
        print("📚 Keep learning — you'll get there!")

    print("=" * 40)


def main():
    """Start the QuizBot application."""
    print("=" * 40)
    print("🤖 PYTHON QUIZ BOT")
    print("=" * 40)

    name = input("What's your name? ").strip()

    if not name:
        name = "Quizzer"

    type_text(f"\n🤖 Hello, {name}! I'll give you 10 random questions.")

    while True:
        run_quiz()

        again = input("\n🔄 Play again? (Y/N): ").strip().upper()

        if again != "Y":
            type_text(f"\n🤖 Thanks for playing, {name}! See you next time 👋")
            break

        print("\n🎲 Creating a new random quiz...")


if __name__ == "__main__":
    main()